# The runner for compose.yaml's `wheel` service: the Linux leg of
# .github/workflows/wheels.yml, run locally. cibuildwheel, with
# python/pyproject.toml's configuration, drives the manylinux build container
# through the host's Docker socket (mounted by the service), exactly as it does
# on a CI runner; `devkit wheel check` then reads the repaired wheel, and
# scripts/wheel_test.sh installs and tests it here -- a glibc newer than the
# wheel's manylinux_2_35 floor, as a user's machine would be.
#
#   pixi run -e docker wheel_linux
#
# See scripts/wheel_linux.sh for what the service is handed.
FROM python:3.14-slim

COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker

# cibuildwheel at the version wheels.yml pins (devkit/tests/test_pins.py);
# click, rich and psutil are what `python -m devkit` imports.
RUN pip install --no-cache-dir cibuildwheel==3.2.1 click rich psutil

WORKDIR /project
CMD ["sh", "-c", "cibuildwheel python --platform linux --output-dir /wheelhouse && python -m devkit wheel check --require opendal /wheelhouse/*.whl && bash scripts/wheel_test.sh /wheelhouse/*.whl"]
