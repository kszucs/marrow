# The runner for compose.yaml's `wheel` service: Python and a Docker client, so
# scripts/wheel_ci.sh can drive cibuildwheel's manylinux container through the
# host's Docker socket, as it does on a CI runner.
#
#   pixi run -e docker wheel_linux
FROM python:3.14-slim

COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /project
CMD ["bash", "scripts/wheel_ci.sh", "/wheelhouse"]
