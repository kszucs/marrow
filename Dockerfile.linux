# Linux dev container for running the suites locally, on either architecture.
#
#   pixi run -e docker test_arm64      # native on Apple Silicon
#   pixi run -e docker test_x86        # linux-64, the platform CI runs
#
# **Which one you can actually use depends on the host.** `arm64` runs natively
# on an Apple Silicon machine and is the fast loop. `x86` is emulated there, and
# Docker's default qemu CPU stops at SSE4.2 -- no AVX -- so the linux-64 mojo
# binary dies with `Illegal instruction` before printing its version. Turn on
# Settings -> General -> "Use Rosetta for x86_64/amd64 emulation" to get AVX2
# and make that service work.
#
# The two are not interchangeable: a fault can belong to Linux (glibc, ELF/JIT
# linking, allocator alignment) or to x86-64 (codegen). `test_ipc.mojo`'s
# dictionary hang reproduces on arm64; `test_scalars.mojo`'s crash does not.
#
# No `--platform` here on purpose -- compose.yaml sets it per service.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV FORCE_COLOR=1
ENV PYTEST_ADDOPTS=--color=yes

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates git gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://pixi.sh/install.sh | bash
ENV PATH="/root/.pixi/bin:$PATH"

WORKDIR /marrow

# Install deps — cached unless pixi.toml / pixi.lock change.
COPY pixi.toml pixi.lock ./
RUN pixi install --frozen -e dev

# Stash the env so the entrypoint can seed the volume on first use.
RUN cp -r .pixi /pixi-env-seed

# On first run the named volume at /marrow/.pixi is empty; copy the seed in.
# Source is bind-mounted at runtime — no COPY . . here.
RUN printf '#!/bin/sh\n[ -d /marrow/.pixi/envs ] || cp -r /pixi-env-seed/. /marrow/.pixi/\nexec "$@"\n' \
    > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["pixi", "run", "-e", "dev", "test"]
