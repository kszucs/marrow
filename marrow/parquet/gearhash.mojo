def gearhash_table() -> List[UInt64]:
    """The table as a runtime list, indexed `run * 256 + byte`.

    A `comptime` value cannot be indexed by a runtime byte, so it has to be
    materialized. Build this **once** per file being written and lend it to the
    chunkers -- it is 16 KiB, and materializing it per chunker or per value
    would be the whole cost of the feature.
    """
    var t = materialize[_GEARHASH]()
    var out = List[UInt64](capacity=2048)
    for i in range(2048):
        out.append(t[i])
    return out^
