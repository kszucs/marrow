"""The dictionary as text: its bytes, but for those that are not UTF-8,
which no string literal can hold -- each of those is `\x7f`, a byte the
dictionary otherwise lacks, and is put back from `_PATCH_BYTE`."""

comptime _PATCH_AT = SIMD[DType.int32, 32](
    1747, 2159, 2311, 2491, 2535, 2603, 3103, 7194,
    7195, 7589, 7590, 43952, 43953, 43954, 43955, 43964,
    43965, 43966, 43967, 43992, 43993, 44002, 44003, -1,
    -1, -1, -1, -1, -1, -1, -1, -1,
)
"""Where the bytes that are not UTF-8 go; -1 pads."""

comptime _PATCH_BYTE = SIMD[DType.uint8, 32](
    0xE5, 0xE6, 0xE8, 0xE4, 0xE7, 0xE9, 0xEC, 0xE3,
    0x82, 0xE3, 0x83, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF,
    0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0,
    0, 0, 0, 0, 0, 0, 0, 0,
)
"""The bytes that are not UTF-8, each at its `_PATCH_AT`."""

# fmt: on


@always_inline
def copy_word(start: Int, length: Int, mut out: Array[UInt8, 64], at: Int):
    """Bytes `start` to `start + length` of the dictionary -- a word, at most
    24 -- into `out` from `at`."""
    var text = StaticString(_TEXT).as_bytes()
    for k in range(length):
        out[at + k] = text[start + k]
    var rel = _PATCH_AT - Int32(start)
    var hit = rel.ge(0) & rel.lt(Int32(length))
    if hit.reduce_or():
        for i in range(len(_PATCH_AT)):
            if hit[i]:
                out[at + Int(rel[i])] = _PATCH_BYTE[i]
